# ========================================================
# HOSPITAL TALAGANTE - CONFIGURACION DEL SISTEMA
# ========================================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo y renombrarlo a: .env
# 2. Cambiar los valores según tu configuración
# 3. NUNCA compartir este archivo (contiene contraseñas)
# 4. Guardar en: backend/.env
#

# ========================================================
# BASE DE DATOS POSTGRESQL
# ========================================================
# Formato: postgresql://usuario:contraseña@servidor:puerto/nombre_base_datos
# Ejemplo: postgresql://postgres:MiPass123@localhost:5432/hospital_talagante
DATABASE_URL=postgresql://postgres:CAMBIAR_ESTE_PASSWORD@localhost:5432/hospital_talagante

# ========================================================
# SEGURIDAD - CLAVES SECRETAS
# ========================================================

# Clave secreta para tokens JWT (CAMBIAR OBLIGATORIO)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ejemplo: BxR9kL2mN5pQ8sT1vW4yZ7aC0dEfGhIjKlMnOpQrStUv
SECRET_KEY=CAMBIAR-POR-CLAVE-ALEATORIA-SEGURA-MINIMO-32-CARACTERES

# Clave para registrar nuevos administradores
# Esta clave se comparte SOLO con administradores autorizados
# Se usa en la página "Registrar Administrador"
ADMIN_SECRET_KEY=clave-super-secreta-compartida-solo-con-admins

# ========================================================
# CORS - CONTROL DE ACCESO
# ========================================================
# Lista de orígenes permitidos (separados por comas, SIN espacios)
# Incluir: localhost + todas las IPs desde donde se accederá

# Solo localhost (desarrollo):
CORS_ORIGINS=http://localhost:5173

# Con acceso desde red local (RECOMENDADO):
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.100:5173,http://192.168.1.101:5173

# Con URL personalizada:
# CORS_ORIGINS=http://localhost:5173,http://hospital.local:5173

# ========================================================
# NOTAS IMPORTANTES
# ========================================================
# 
# ✅ Para obtener tu IP local:
#    - Windows: ejecutar OBTENER_IP.bat
#    - Linux/Mac: ejecutar ./obtener_ip.sh
#    - O manualmente: ipconfig (Windows) / ifconfig (Linux/Mac)
#
# ✅ Agregar TODAS las IPs desde donde se accederá al sistema
#
# ✅ Cambiar SECRET_KEY antes de usar en producción
#    NO usar claves de ejemplo
#
# ✅ El ADMIN_SECRET_KEY:
#    - Solo se comparte verbalmente con administradores
#    - Cambiarla periódicamente (cada 6 meses)
#    - NO enviarla por email ni chat
#
# ✅ Este archivo NO debe subirse a Git
#    Está en .gitignore por seguridad
#
# ========================================================