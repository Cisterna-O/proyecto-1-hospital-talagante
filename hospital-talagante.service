[Unit]
Description=Hospital Talagante - Sistema de Gestión de Exámenes
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=forking
User=TU_USUARIO
WorkingDirectory=/ruta/completa/al/Proyecto
ExecStart=/ruta/completa/al/Proyecto/iniciar_todo.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target